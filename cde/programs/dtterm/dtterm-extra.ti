# dtterm 256-colour and 24-bit direct-colour entries.
#
# These are opt-in: leave TERM=dtterm for the historical 8-colour behaviour;
# set TERM=dtterm-256color or TERM=dtterm-direct (the latter implies the
# former) to advertise the extra capabilities to terminfo-aware applications
# such as vim, neovim, tmux, htop and less.
#
# Compile with `tic -x dtterm-extra.ti`.  The installation hook in the
# Makefile takes care of this automatically.

dtterm-256color|dtterm with the xterm 256-colour palette,
	colors#256,
	setaf=\E[%?%p1%{8}%<%t3%p1%d%e%p1%{16}%<%t9%p1%{8}%-%d%e38;5;%p1%d%;m,
	setab=\E[%?%p1%{8}%<%t4%p1%d%e%p1%{16}%<%t10%p1%{8}%-%d%e48;5;%p1%d%;m,
	use=dtterm,

dtterm-direct|dtterm with 24-bit direct colour,
	colors#0x1000000,
	RGB,
	setrgbf=\E[38;2;%p1%d;%p2%d;%p3%dm,
	setrgbb=\E[48;2;%p1%d;%p2%d;%p3%dm,
	use=dtterm-256color,
